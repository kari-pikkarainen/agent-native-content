.DS_Store
.python-version
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]

# Downloaded data, caches, indexes, and complete generated runs stay local.
# Compact canonical evidence is published separately under results/.
data/cache/**
data/processed/**
data/raw/**
artifacts/**

# Keep the expected directory layout in fresh clones.
!data/cache/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep
!artifacts/indexes/
!artifacts/indexes/.gitkeep
!artifacts/runs/
!artifacts/runs/.gitkeep

# Secrets: API keys belong in the shell environment, never in the repository.
.env
.env.*
